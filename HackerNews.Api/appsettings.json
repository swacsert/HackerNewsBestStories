{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "RequestTimeout": "00:00:10",
    "MaxConnectionsPerServer": 20,
    "MaxDegreeOfParallelism": 10,
    "RefreshInterval": "00:05:00",
    "MaxStoriesPerRequest": 200
  }
}
